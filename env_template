COMPOSE_PROJECT_NAME=analytics
PLATFORM=linux/amd64

PROJECT_DIR=.

# service port
ANALYTICS_ENGINE_PORT=8080
ANALYTICS_ENGINE_SQL_PORT=7432
ANALYTICS_AI_SERVICE_PORT={{ANALYTICS_AI_SERVICE_PORT}}
ANALYTICS_UI_PORT=3000
IBIS_SERVER_PORT=8000
ANALYTICS_UI_ENDPOINT=http://analytics-ui:${ANALYTICS_UI_PORT}

ANALYTICS_ENGINE_ENDPOINT=http://analytics-engine:${ANALYTICS_ENGINE_PORT}
IBIS_SERVER_ENDPOINT=http://ibis-server:${IBIS_SERVER_PORT}
ANALYTICS_AI_ENDPOINT=http://analytics-service:${ANALYTICS_AI_SERVICE_PORT}

# ai service settings
QDRANT_HOST=qdrant
SHOULD_FORCE_DEPLOY=1

# vendor keys
OPENAI_API_KEY={{OPENAI_API_KEY}}

# PageIndex API key — required for Document RAG (upload/index/Q&A on PDFs).
# Get one at https://dash.pageindex.ai/. Leave blank to disable the document
# RAG feature; SQL Q&A continues to work without it.
PAGEINDEX_API_KEY={{PAGEINDEX_API_KEY}}

# user id
USER_UUID={{USER_UUID}}

# other services
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
TELEMETRY_ENABLED=false
GENERATION_MODEL={{GENERATION_MODEL}}
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=

# ports
HOST_PORT={{HOST_PORT}}
AI_SERVICE_FORWARD_PORT={{AI_SERVICE_FORWARD_PORT}}

# Analytics UI
PERSIST_CREDENTIAL_DIR=/app/data
EXPERIMENTAL_ENGINE_RUST_VERSION=false
DB_TYPE=pg
# Password for DB user "analytics"; must match the password in PG_URL below
ANALYTICS_DB_PASSWORD=analytics123
PG_URL=postgres://analytics:analytics123@northwind-db:${POSTGRES_PORT}/analytics
NEXT_PUBLIC_TELEMETRY_ENABLED=false

# Authentication (REQUIRED)
JWT_SECRET={{JWT_SECRET}}
NEXTAUTH_SECRET={{NEXTAUTH_SECRET}}
NEXTAUTH_URL=http://localhost:3000
# Required when Keycloak is behind Traefik with self-signed TLS certificate
NODE_TLS_REJECT_UNAUTHORIZED=0

# Keycloak / NQRust Identity SSO (Optional)
KEYCLOAK_OAUTH_ENABLED={{KEYCLOAK_OAUTH_ENABLED}}
KEYCLOAK_PUBLIC_URL={{KEYCLOAK_PUBLIC_URL}}
KEYCLOAK_URL={{KEYCLOAK_URL}}
KEYCLOAK_REALM={{KEYCLOAK_REALM}}
KEYCLOAK_CLIENT_ID={{KEYCLOAK_CLIENT_ID}}
KEYCLOAK_CLIENT_SECRET={{KEYCLOAK_CLIENT_SECRET}}
KEYCLOAK_DEFAULT_ROLE={{KEYCLOAK_DEFAULT_ROLE}}
KEYCLOAK_AUTO_REGISTER={{KEYCLOAK_AUTO_REGISTER}}

# Analytics Engine
LOCAL_STORAGE=.

# Northwind Database
POSTGRES_PORT=5435
POSTGRES_DB=northwind
POSTGRES_USER=demo
POSTGRES_PASSWORD=demo123

# Analytics Service
PYTHONUNBUFFERED=1
CONFIG_PATH=/app/config.yaml


COMPOSE_PROJECT_NAME=analytics
PLATFORM=linux/amd64

PROJECT_DIR=.

# service port
ANALYTICS_ENGINE_PORT=8080
ANALYTICS_ENGINE_SQL_PORT=7432
ANALYTICS_AI_SERVICE_PORT=5555
ANALYTICS_UI_PORT=3000
IBIS_SERVER_PORT=8000
ANALYTICS_UI_ENDPOINT=http://analytics-ui:${ANALYTICS_UI_PORT}

ANALYTICS_ENGINE_ENDPOINT=http://analytics-engine:${ANALYTICS_ENGINE_PORT}
IBIS_SERVER_ENDPOINT=http://ibis-server:${IBIS_SERVER_PORT}
ANALYTICS_AI_ENDPOINT=http://analytics-service:${ANALYTICS_AI_SERVICE_PORT}

# ai service settings
QDRANT_HOST=qdrant
# Set to "1" only if you intentionally want to wipe and rebuild every
# Qdrant collection on each container startup. Leave at 0 (or remove the
# line) for normal operation — recreate-on-startup combined with
# gunicorn's multi-worker model used to race on Qdrant 409 Conflict and
# crash workers until one survived.
SHOULD_FORCE_DEPLOY=0

# vendor keys - REQUIRED: Add your API keys here
OPENAI_API_KEY=your-openai-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here

# user id
USER_UUID=demo-user-123

# other services
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
TELEMETRY_ENABLED=false
GENERATION_MODEL=openrouter/anthropic/claude-sonnet-4.5
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=

# ports
HOST_PORT=3000
AI_SERVICE_FORWARD_PORT=5555

# Analytics UI
EXPERIMENTAL_ENGINE_RUST_VERSION=false
DB_TYPE=pg
PG_URL=postgres://demo:demo123@northwind-db:5432/northwind
NEXT_PUBLIC_TELEMETRY_ENABLED=false

# Authentication (REQUIRED)
JWT_SECRET=change-this-to-a-secure-random-string
NEXTAUTH_SECRET=change-this-to-another-secure-random-string
NEXTAUTH_URL=http://localhost:3000

# URL the analytics-service uses to POST async results (document tree, etc.)
# back to analytics-ui. Must be reachable from inside the AI service
# container — use the docker service name, not the host machine's IP, or
# the callback will silently fail and documents will hang at "indexing".
CALLBACK_BASE_URL=http://analytics-ui:3000

# Keycloak / NQRust Identity SSO (Optional)
KEYCLOAK_OAUTH_ENABLED=false
KEYCLOAK_PUBLIC_URL=
KEYCLOAK_URL=
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_DEFAULT_ROLE=viewer
KEYCLOAK_AUTO_REGISTER=true

# Analytics Engine
LOCAL_STORAGE=.

# Northwind Database
POSTGRES_DB=northwind
POSTGRES_USER=demo
POSTGRES_PASSWORD=demo123

# Analytics Service
PYTHONUNBUFFERED=1
CONFIG_PATH=/app/config.yaml
